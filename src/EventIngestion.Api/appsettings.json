{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "",
      "Password": "",
      "VirtualHost": "/",
      "ExchangeName": "events",
      "ExchangeType": "topic",
      "RoutingKey": "events.ingested",
      "UseTls": true
    },
    "AzureServiceBus": {
      "EntityName": "events",
      "EntityType": "Topic"
    }
  }
}
